<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Todo List</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      color: #1f2937;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    header, footer {
      background-color: #1e293b;
      color: #ffffff;
      padding: 1rem 1.5rem;
      text-align: center;
    }

    header h1 {
      margin: 0 0 0.25rem;
      font-size: 1.5rem;
    }

    #count {
      margin: 0;
      font-size: 1rem;
      color: #cbd5e1;
    }

    main {
      flex: 1;
      max-width: 960px;
      width: 100%;
      margin: 0 auto;
      padding: 1.5rem;
    }

    #status {
      text-align: center;
      font-weight: 500;
      margin-bottom: 1rem;
    }

    .error {
      color: #dc2626;
    }

    /* Mobile-first: 1 column on phones */
    #todo-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    /* Tablet & Desktop: 2+ columns at 768px and wider */
    @media (min-width: 768px) {
      #todo-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .card {
      background-color: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 1rem;
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .card-status {
      font-size: 1.25rem;
      line-height: 1.2;
    }

    .card-title {
      margin: 0;
      font-size: 1rem;
      line-height: 1.4;
    }
  </style>
</head>
<body>
  <header>
    <h1>My Todos</h1>
    <p id="count">0 of 0 completed</p>
  </header>

  <main>
    <p id="status" role="status">Loading…</p>
    <section id="todo-grid" aria-label="Todo items"></section>
  </main>

  <footer>
    <p>420-A07-TV-2026 &mdash; Practical Test 1</p>
  </footer>

  <script>
    const statusEl = document.getElementById("status");
    const countEl = document.getElementById("count");
    const gridEl = document.getElementById("todo-grid");

    async function loadTodos() {
      statusEl.textContent = "Loading…";
      statusEl.classList.remove("error");

      try {
        const response = await fetch("https://typicode.com");
        if (!response.ok) {
          throw new Error(`HTTP error: ${response.status}`);
        }

        const todos = await response.json();
        statusEl.textContent = "";

        const completedCount = todos.filter((todo) => todo.completed).length;
        countEl.textContent = `${completedCount} of ${todos.length} completed`;

        for (const todo of todos) {
          const card = document.createElement("article");
          card.className = "card";

          const icon = document.createElement("span");
          icon.className = "card-status";
          icon.textContent = todo.completed ? "✅" : "⬜";

          const title = document.createElement("p");
          title.className = "card-title";
          title.textContent = todo.title;

          card.append(icon, title);
          gridEl.append(card);
        }
      } catch (error) {
        statusEl.textContent = "Could not load todos. Please check your internet connection and try again.";
        statusEl.classList.add("error");
      }
    }

    loadTodos();
  </script>
</body>
</html>
